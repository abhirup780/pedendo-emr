# Copy to .env.local for local development. In Cloudflare Pages, set these
# under Settings > Environment variables. Both values are safe to expose to
# the browser; data is protected by row-level security in the database.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional, for photographs: the OAuth client ID from Google Cloud (it ends in
# .apps.googleusercontent.com). Leave it out and the Photos screen explains what is missing.
VITE_GOOGLE_CLIENT_ID=
