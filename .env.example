# Copy to .env.local for local development. In Cloudflare, set these as build
# variables (the Worker's Settings > Build). Both values are safe to expose to
# the browser; data is protected by row-level security in the database.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: the one email address allowed to use this deployment. Anyone else who signs in is
# signed straight out again. (The real lock is switching off new sign-ups in Supabase; see
# docs/SETUP.md.)
VITE_ALLOWED_EMAIL=
