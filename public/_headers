# Response headers for Cloudflare Workers static assets (other static hosts have their own way to set these).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()
  # Report-only for now: the browser logs anything this policy would block but blocks nothing.
  # It has not been tried against the live site yet, so it stays advisory until a trial run
  # shows a clean console. Then rename the header to Content-Security-Policy.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
